# GEMINI_API_KEY: Required for the AI Tutor (server-side only).
# Set this as an environment variable on your host (Render service env var).
# NEVER expose it to the browser (no VITE_ prefix, never in client code).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
